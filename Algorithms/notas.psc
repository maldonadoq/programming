Proceso Notas
	Definir final Como Real
	Definir pc1, pc2, pa, exf Como Real
	Escribir "Ingrese su nota de PC1: " Sin Saltar
	Leer pc1
	
	Escribir "Ingrese su nota de PC2: " Sin Saltar
	Leer pc2
	
	Escribir "Ingrese su nota de PA: " Sin Saltar
	Leer pa
	
	Escribir "Ingrese su nota de EXF: " Sin Saltar
	Leer exf
	
	final <- 0.2*pc1 + 0.25*pc2 + 0.25*pa + 0.3*exf
	Escribir "Calificación Final: ", final
	
FinProceso