Proceso MostrarSalidas
	Definir nombre, apellido Como Cadena
	Definir nota Como Real
	
	nombre <- "María"
	nota <- 15.5
	
	Escribir "Estudiante: ", nombre
	Escribir "Alumno: ", nombre, " | Nota: ", nota
	
	Escribir "Ingresa tu nombre: "
	Leer nombre
	
	Escribir "Ingresa tu apellido: " Sin Saltar
	Leer apellido
FinProceso